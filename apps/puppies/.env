# Both values are public by design — the publishable key ships in the bundle and
# is only useful alongside the RLS policies in db/schema.sql, which are what
# actually decide who may read a match or write a command. Committed on purpose
# so a deploy needs no environment configuration.
VITE_SUPABASE_URL=https://epeeytrunzxbqvtfwtkr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PbtMeY8uaWvcgja9vxFv4A_8_UciIkG

# Which clicker this build is. Keeps the two lobbies apart in one schema.
VITE_GAME=puppies
