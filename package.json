{
  "name": "clickers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @clickers/potatoes",
    "dev:potatoes": "npm run dev -w @clickers/potatoes",
    "dev:puppies": "npm run dev -w @clickers/puppies",
    "build": "npm run build:potatoes && npm run build:puppies",
    "build:potatoes": "npm run build -w @clickers/potatoes",
    "build:puppies": "npm run build -w @clickers/puppies",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/sim --noEmit && tsc -p apps/potatoes --noEmit && tsc -p apps/puppies --noEmit"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
